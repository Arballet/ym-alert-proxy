# Yandex Messenger bot OAuth token (required)
YANDEX_TOKEN=

# Shared secret; Alertmanager must send "Authorization: Bearer <value>" (recommended)
WEBHOOK_TOKEN=

# Used to build "Silence" links; leave empty to omit them
ALERTMANAGER_BASE_URL=https://alertmanager.example.com

# One variable per value of the "team" alert label: <TEAM>_CHAT_ID
# Several chats can be listed with commas
BACKEND_CHAT_ID=0/0/00000000-0000-0000-0000-000000000000
INFRA_CHAT_ID=

LOG_LEVEL=INFO
